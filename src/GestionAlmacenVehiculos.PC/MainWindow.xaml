<Window x:Class="GestionAlmacenVehiculos.PC.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:scottPlot="clr-namespace:ScottPlot.WPF;assembly=ScottPlot.WPF"
        Title="Vehicle · Almacén"
        Height="780" Width="1200"
        MinHeight="640" MinWidth="980"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource PaperBrush}"
        FontFamily="{StaticResource BodyFont}"
        Loaded="Window_Loaded"
        Closing="Window_Closing"
        PreviewKeyDown="Window_PreviewKeyDown">
  <Grid>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="232"/>
      <ColumnDefinition Width="*"/>
    </Grid.ColumnDefinitions>

    <Border x:Name="SidebarRoot" Grid.Column="0">
      <DockPanel>
        <StackPanel DockPanel.Dock="Top" Margin="20,28,20,20">
          <Image x:Name="BrandLogoImage" MaxHeight="56" MaxWidth="180" Stretch="Uniform"
                 HorizontalAlignment="Left" Margin="0,0,0,10" Visibility="Collapsed"/>
          <TextBlock x:Name="BrandText" Text="VEHICLE" FontFamily="{StaticResource DisplayFont}"
                     FontSize="28" FontWeight="Bold" Foreground="White"/>
          <TextBlock x:Name="TaglineText" TextWrapping="Wrap" Foreground="#B7D9D4" Margin="0,6,0,0" FontSize="12"/>
          <Border x:Name="SidebarSessionChip" Background="#2AFFFFFF" CornerRadius="8" Padding="10,8" Margin="0,14,0,0" Visibility="Collapsed">
            <StackPanel>
              <TextBlock x:Name="SidebarSessionUser" Foreground="White" FontSize="12" FontWeight="SemiBold" TextWrapping="Wrap"/>
              <TextBlock x:Name="SidebarSessionRoles" Foreground="#B7D9D4" FontSize="11" TextWrapping="Wrap" Margin="0,4,0,0"/>
            </StackPanel>
          </Border>
        </StackPanel>
        <Button x:Name="LangButton" DockPanel.Dock="Bottom" Style="{StaticResource NavGhostButton}"
                Margin="16,16,16,24" Click="LangButton_Click"/>
        <StackPanel Margin="0,8,0,0">
          <RadioButton x:Name="NavConnection" Style="{StaticResource NavButton}" Content="" IsChecked="True" Checked="Nav_Checked"/>
          <RadioButton x:Name="NavBrand" Style="{StaticResource NavButton}" Content="" Checked="Nav_Checked"/>
          <RadioButton x:Name="NavWarehouses" Style="{StaticResource NavButton}" Content="" Checked="Nav_Checked"/>
          <RadioButton x:Name="NavCurrent" Style="{StaticResource NavButton}" Content="" Checked="Nav_Checked"/>
          <RadioButton x:Name="NavMap" Style="{StaticResource NavButton}" Content="" Checked="Nav_Checked"/>
          <RadioButton x:Name="NavHistory" Style="{StaticResource NavButton}" Content="" Checked="Nav_Checked"/>
          <RadioButton x:Name="NavRegistros" Style="{StaticResource NavButton}" Content="" Checked="Nav_Checked"/>
          <RadioButton x:Name="NavUsers" Style="{StaticResource NavButton}" Content="" Checked="Nav_Checked"/>
        </StackPanel>
      </DockPanel>
    </Border>

    <Grid Grid.Column="1" Margin="28,24">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="*"/>
      </Grid.RowDefinitions>
      <StackPanel Grid.Row="0" Margin="0,0,0,14">
        <DockPanel Margin="0,0,0,4">
          <TextBlock x:Name="PageTitle" DockPanel.Dock="Left" FontFamily="{StaticResource DisplayFont}"
                     FontSize="26" FontWeight="SemiBold" Foreground="{StaticResource InkBrush}"/>
          <StackPanel DockPanel.Dock="Right" HorizontalAlignment="Right" VerticalAlignment="Center">
            <TextBlock x:Name="ApiStatusText" HorizontalAlignment="Right"
                       Foreground="{StaticResource InkMutedBrush}" FontSize="13"/>
            <TextBlock x:Name="ActionStatusText" HorizontalAlignment="Right" FontSize="12" Margin="0,2,0,0"
                       Visibility="Collapsed"/>
          </StackPanel>
        </DockPanel>
        <TextBlock x:Name="HeaderPermissionHint" TextWrapping="Wrap" Foreground="{StaticResource WarnBrush}"
                   FontSize="12" Visibility="Collapsed"/>
      </StackPanel>

      <Border x:Name="PanelConnection" Grid.Row="1" Background="{StaticResource PanelBrush}" CornerRadius="12"
              BorderBrush="{StaticResource LineBrush}" BorderThickness="1" Padding="24">
        <StackPanel MaxWidth="560" HorizontalAlignment="Left">
          <TextBlock x:Name="LblServerUrl" Margin="0,0,0,6" Foreground="{StaticResource InkMutedBrush}"/>
          <TextBox x:Name="ServerUrlBox" Margin="0,0,0,14"/>
          <TextBlock x:Name="LblUsername" Margin="0,0,0,6" Foreground="{StaticResource InkMutedBrush}"/>
          <TextBox x:Name="UsernameBox" Margin="0,0,0,14"/>
          <TextBlock x:Name="LblPassword" Margin="0,0,0,6" Foreground="{StaticResource InkMutedBrush}"/>
          <PasswordBox x:Name="PasswordBox" Margin="0,0,0,16" KeyDown="PasswordBox_KeyDown"/>
          <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
            <Button x:Name="TestServerButton" Margin="0,0,8,0" Click="TestServer_Click"/>
            <Button x:Name="LoginButton" Margin="0,0,8,0" Click="Login_Click"/>
            <Button x:Name="LogoutButton" Style="{StaticResource GhostButton}" Margin="0,0,8,0" Click="Logout_Click"/>
            <Button x:Name="SaveSettingsButton" Style="{StaticResource GhostButton}" Click="SaveSettings_Click"/>
          </StackPanel>
          <TextBlock x:Name="ServerHintText" TextWrapping="Wrap" Foreground="{StaticResource InkMutedBrush}" Margin="0,0,0,8"/>
          <Border x:Name="SessionBanner" Background="{StaticResource SurfaceMutedBrush}" CornerRadius="8" Padding="12,10" Margin="0,4,0,0" Visibility="Collapsed">
            <StackPanel>
              <TextBlock x:Name="SessionBannerUser" FontWeight="SemiBold" Foreground="{StaticResource InkBrush}"/>
              <TextBlock x:Name="SessionBannerRoles" TextWrapping="Wrap" Foreground="{StaticResource InkMutedBrush}" FontSize="12" Margin="0,4,0,0"/>
            </StackPanel>
          </Border>
          <TextBlock x:Name="PermissionHintText" TextWrapping="Wrap" Foreground="{StaticResource WarnBrush}" Margin="0,10,0,0" Visibility="Collapsed"/>
          <TextBlock x:Name="ClaimsPendingText" TextWrapping="Wrap" Foreground="{StaticResource InkMutedBrush}" Margin="0,8,0,0" Visibility="Collapsed"/>
        </StackPanel>
      </Border>

      <Border x:Name="PanelWarehouses" Grid.Row="1" Visibility="Collapsed" Background="{StaticResource PanelBrush}"
              CornerRadius="12" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" Padding="20">
        <DockPanel>
          <StackPanel DockPanel.Dock="Top" Margin="0,0,0,14">
            <TextBlock x:Name="NoWarehousesHint" TextWrapping="Wrap" Foreground="{StaticResource AccentDeepBrush}" Margin="0,0,0,12"/>
            <WrapPanel>
              <StackPanel Margin="0,0,12,8" Width="180">
                <TextBlock x:Name="LblWhName" FontSize="11" Foreground="{StaticResource InkMutedBrush}" Margin="0,0,0,4"/>
                <TextBox x:Name="WhName"/>
              </StackPanel>
              <StackPanel Margin="0,0,12,8" Width="70">
                <TextBlock x:Name="LblWhRows" FontSize="11" Foreground="{StaticResource InkMutedBrush}" Margin="0,0,0,4"/>
                <TextBox x:Name="WhRows" KeyDown="WhCreateFields_KeyDown"/>
              </StackPanel>
              <StackPanel Margin="0,0,12,8" Width="70">
                <TextBlock x:Name="LblWhCols" FontSize="11" Foreground="{StaticResource InkMutedBrush}" Margin="0,0,0,4"/>
                <TextBox x:Name="WhCols" KeyDown="WhCreateFields_KeyDown"/>
              </StackPanel>
              <StackPanel Orientation="Horizontal" VerticalAlignment="Bottom" Margin="0,0,0,8">
                <Button x:Name="CreateWhButton" Click="CreateWarehouse_Click"/>
                <Button x:Name="RefreshWhButton" Style="{StaticResource GhostButton}" Margin="8,0,0,0" Click="RefreshAll_Click"/>
              </StackPanel>
            </WrapPanel>
          </StackPanel>
          <DataGrid x:Name="WarehousesGrid" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False">
            <DataGrid.Columns>
              <DataGridTextColumn Binding="{Binding Code}" Width="120"/>
              <DataGridTextColumn Binding="{Binding Name}" Width="180"/>
              <DataGridTextColumn Binding="{Binding Rows}" Width="80"/>
              <DataGridTextColumn Binding="{Binding Columns}" Width="90"/>
              <DataGridTextColumn Binding="{Binding GridText}" Width="100"/>
              <DataGridTextColumn Binding="{Binding SiteKind}" Width="100"/>
            </DataGrid.Columns>
          </DataGrid>
        </DockPanel>
      </Border>

      <Border x:Name="PanelCurrent" Grid.Row="1" Visibility="Collapsed" Background="{StaticResource PanelBrush}"
              CornerRadius="12" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" Padding="20">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="280"/>
          </Grid.ColumnDefinitions>
          <DockPanel Grid.Column="0" Margin="0,0,14,0">
            <StackPanel DockPanel.Dock="Top" Margin="0,0,0,14">
              <UniformGrid Columns="4" Margin="0,0,0,12">
                <Border Style="{StaticResource KpiCard}" Margin="0,0,8,0">
                  <StackPanel>
                    <TextBlock x:Name="KpiParkedLabel" Style="{StaticResource CaptionLabel}"/>
                    <TextBlock x:Name="KpiParkedValue" FontSize="22" FontWeight="SemiBold" Foreground="{StaticResource AccentDeepBrush}"/>
                  </StackPanel>
                </Border>
                <Border x:Name="KpiFillCard" Style="{StaticResource KpiCard}" Margin="0,0,8,0">
                  <StackPanel>
                    <TextBlock x:Name="KpiFillLabel" Style="{StaticResource CaptionLabel}"/>
                    <TextBlock x:Name="KpiFillValue" FontSize="22" FontWeight="SemiBold" Foreground="{StaticResource AccentDeepBrush}"/>
                  </StackPanel>
                </Border>
                <Border Style="{StaticResource KpiCard}" Margin="0,0,8,0">
                  <StackPanel>
                    <TextBlock x:Name="KpiFreeLabel" Style="{StaticResource CaptionLabel}"/>
                    <TextBlock x:Name="KpiFreeValue" FontSize="22" FontWeight="SemiBold" Foreground="{StaticResource InkBrush}"/>
                  </StackPanel>
                </Border>
                <Border Style="{StaticResource KpiCard}" Margin="0">
                  <StackPanel>
                    <TextBlock x:Name="KpiModelsLabel" Style="{StaticResource CaptionLabel}"/>
                    <TextBlock x:Name="KpiModelsValue" FontSize="22" FontWeight="SemiBold" Foreground="{StaticResource InkBrush}"/>
                  </StackPanel>
                </Border>
              </UniformGrid>
              <TextBlock x:Name="ParkFormHint" TextWrapping="Wrap" Foreground="{StaticResource InkMutedBrush}" Margin="0,0,0,10"/>
              <WrapPanel>
                <StackPanel Margin="0,0,8,8" Width="180">
                  <TextBlock x:Name="LblParkWarehouse" Style="{StaticResource CaptionLabel}" Margin="0,0,0,4"/>
                  <ComboBox x:Name="ParkWarehouseBox" DisplayMemberPath="Name" SelectedValuePath="Id" SelectionChanged="ParkWarehouseBox_SelectionChanged"/>
                </StackPanel>
                <StackPanel Margin="0,0,8,8" Width="120">
                  <TextBlock x:Name="LblParkModel" Style="{StaticResource CaptionLabel}" Margin="0,0,0,4"/>
                  <TextBox x:Name="ParkModelBox"/>
                </StackPanel>
                <StackPanel Margin="0,0,8,8" Width="110">
                  <TextBlock x:Name="LblParkBin" Style="{StaticResource CaptionLabel}" Margin="0,0,0,4"/>
                  <TextBox x:Name="ParkBinBox"/>
                </StackPanel>
                <StackPanel Margin="0,0,8,8" Width="100">
                  <TextBlock x:Name="LblParkColor" Style="{StaticResource CaptionLabel}" Margin="0,0,0,4"/>
                  <TextBox x:Name="ParkColorBox"/>
                </StackPanel>
                <StackPanel Margin="0,0,8,8" Width="60">
                  <TextBlock x:Name="LblParkRow" Style="{StaticResource CaptionLabel}" Margin="0,0,0,4"/>
                  <TextBox x:Name="ParkRowBox"/>
                </StackPanel>
                <StackPanel Margin="0,0,8,8" Width="60">
                  <TextBlock x:Name="LblParkPos" Style="{StaticResource CaptionLabel}" Margin="0,0,0,4"/>
                  <TextBox x:Name="ParkPosBox"/>
                </StackPanel>
                <StackPanel Margin="0,0,8,8" Width="160">
                  <TextBlock x:Name="LblParkNotes" Style="{StaticResource CaptionLabel}" Margin="0,0,0,4"/>
                  <TextBox x:Name="ParkNotesBox"/>
                </StackPanel>
              </WrapPanel>
              <StackPanel Orientation="Horizontal">
                <Button x:Name="ParkButton" Margin="0,0,8,0" Click="Park_Click"/>
                <Button x:Name="UnparkButton" Style="{StaticResource GhostButton}" Margin="0,0,8,0" Click="Unpark_Click"/>
                <Button x:Name="RefreshCurrentButton" Style="{StaticResource GhostButton}" Click="RefreshAll_Click"/>
              </StackPanel>
              <TextBlock x:Name="EmptyCurrentHint" Style="{StaticResource EmptyStateText}" Visibility="Collapsed"/>
            </StackPanel>
            <DataGrid x:Name="CurrentGrid" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False"
                      SelectionChanged="CurrentGrid_SelectionChanged"
                      MouseDoubleClick="CurrentGrid_MouseDoubleClick">
              <DataGrid.Columns>
                <DataGridTextColumn Binding="{Binding WarehouseName}" Width="110"/>
                <DataGridTextColumn Binding="{Binding Model}" Width="100"/>
                <DataGridTextColumn Binding="{Binding Bin}" Width="100"/>
                <DataGridTextColumn Binding="{Binding Color}" Width="80"/>
                <DataGridTextColumn Binding="{Binding Row}" Width="50"/>
                <DataGridTextColumn Binding="{Binding Position}" Width="60"/>
                <DataGridTextColumn Binding="{Binding UserDisplayName}" Width="110"/>
                <DataGridTextColumn Binding="{Binding TimeLocal}" Width="120"/>
                <DataGridTextColumn Binding="{Binding GpsText}" Width="*"/>
              </DataGrid.Columns>
            </DataGrid>
          </DockPanel>
          <DockPanel Grid.Column="1">
            <TextBlock x:Name="ChartStockByModelTitle" DockPanel.Dock="Top" FontWeight="SemiBold" Margin="0,0,0,8"
                       Foreground="{StaticResource InkBrush}"/>
            <scottPlot:WpfPlot x:Name="EstadoPlotModels"/>
          </DockPanel>
        </Grid>
      </Border>

      <Border x:Name="PanelHistory" Grid.Row="1" Visibility="Collapsed" Background="{StaticResource PanelBrush}"
              CornerRadius="12" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" Padding="20">
        <DockPanel>
          <StackPanel DockPanel.Dock="Top" Margin="0,0,0,12">
            <StackPanel Orientation="Horizontal">
              <StackPanel Margin="0,0,8,0">
                <TextBlock x:Name="LblHistoryFilter" Style="{StaticResource CaptionLabel}" Margin="0,0,0,4"/>
                <TextBox x:Name="HistoryFilter" Width="200"/>
              </StackPanel>
              <Button x:Name="RefreshHistoryButton" VerticalAlignment="Bottom" Click="RefreshAll_Click"/>
            </StackPanel>
            <TextBlock x:Name="EmptyHistoryHint" Style="{StaticResource EmptyStateText}" Visibility="Collapsed"/>
          </StackPanel>
          <DataGrid x:Name="HistoryGrid" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False">
            <DataGrid.Columns>
              <DataGridTextColumn Binding="{Binding WarehouseName}" Width="110"/>
              <DataGridTextColumn Binding="{Binding Model}" Width="100"/>
              <DataGridTextColumn Binding="{Binding Bin}" Width="100"/>
              <DataGridTextColumn Binding="{Binding Color}" Width="80"/>
              <DataGridTextColumn Binding="{Binding Row}" Width="50"/>
              <DataGridTextColumn Binding="{Binding Position}" Width="60"/>
              <DataGridTextColumn Binding="{Binding UserDisplayName}" Width="110"/>
              <DataGridTextColumn Binding="{Binding TimeLocal}" Width="120"/>
              <DataGridTextColumn Binding="{Binding GpsText}" Width="*"/>
            </DataGrid.Columns>
          </DataGrid>
        </DockPanel>
      </Border>

      <Border x:Name="PanelRegistros" Grid.Row="1" Visibility="Collapsed" Background="{StaticResource PanelBrush}"
              CornerRadius="12" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" Padding="20">
        <DockPanel>
          <StackPanel DockPanel.Dock="Top" Margin="0,0,0,12">
            <TextBlock x:Name="RegistrosHintText" TextWrapping="Wrap" Foreground="{StaticResource InkMutedBrush}" Margin="0,0,0,8"/>
            <TextBlock x:Name="RegistrosAuditLimitedText" TextWrapping="Wrap" Foreground="{StaticResource AccentDeepBrush}"
                       Margin="0,0,0,8" Visibility="Collapsed"/>
            <StackPanel Orientation="Horizontal">
              <StackPanel Margin="0,0,8,0">
                <TextBlock x:Name="LblRegistrosFilter" Style="{StaticResource CaptionLabel}" Margin="0,0,0,4"/>
                <TextBox x:Name="RegistrosFilter" Width="180"/>
              </StackPanel>
              <StackPanel Margin="0,0,8,0">
                <TextBlock x:Name="LblRegistrosKind" Style="{StaticResource CaptionLabel}" Margin="0,0,0,4"/>
                <ComboBox x:Name="RegistrosKindBox" Width="140"/>
              </StackPanel>
              <Button x:Name="RefreshRegistrosButton" VerticalAlignment="Bottom" Margin="0,0,8,0" Click="RefreshAll_Click"/>
              <Button x:Name="ExportRegistrosCsvButton" Style="{StaticResource GhostButton}" VerticalAlignment="Bottom" Margin="0,0,8,0" Click="ExportRegistrosCsv_Click"/>
              <Button x:Name="ExportRegistrosJsonButton" Style="{StaticResource GhostButton}" VerticalAlignment="Bottom" Click="ExportRegistrosJson_Click"/>
            </StackPanel>
            <TextBlock x:Name="EmptyRegistrosHint" Style="{StaticResource EmptyStateText}" Visibility="Collapsed"/>
          </StackPanel>
          <DataGrid x:Name="RegistrosGrid" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False">
            <DataGrid.Columns>
              <DataGridTextColumn Binding="{Binding TimeLocal}" Width="130"/>
              <DataGridTextColumn Binding="{Binding UserDisplayName}" Width="120"/>
              <DataGridTextColumn Binding="{Binding Kind}" Width="90"/>
              <DataGridTextColumn Binding="{Binding Detail}" Width="*"/>
              <DataGridTextColumn Binding="{Binding WarehouseName}" Width="110"/>
              <DataGridTextColumn Binding="{Binding Bin}" Width="100"/>
              <DataGridTextColumn Binding="{Binding Source}" Width="70"/>
            </DataGrid.Columns>
          </DataGrid>
        </DockPanel>
      </Border>

      <Border x:Name="PanelMap" Grid.Row="1" Visibility="Collapsed" Background="{StaticResource PanelBrush}"
              CornerRadius="12" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" Padding="16">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="280"/>
          </Grid.ColumnDefinitions>
          <DockPanel Grid.Column="0" Margin="0,0,14,0">
            <StackPanel DockPanel.Dock="Top" Margin="0,0,0,10">
              <TextBlock x:Name="MapHintText" TextWrapping="Wrap" Foreground="{StaticResource InkMutedBrush}" Margin="0,0,0,8"/>
              <WrapPanel>
                <ComboBox x:Name="MapWarehouseBox" Width="180" Margin="0,0,12,8"
                          DisplayMemberPath="Name" SelectedValuePath="Id"
                          SelectionChanged="MapWarehouseBox_SelectionChanged"/>
                <StackPanel Orientation="Horizontal" Margin="0,0,12,8">
                  <RadioButton x:Name="MapModeView" Style="{StaticResource SegmentRadio}" GroupName="MapMode" IsChecked="True" Checked="MapMode_Checked"/>
                  <RadioButton x:Name="MapModePaint" Style="{StaticResource SegmentRadio}" GroupName="MapMode" Checked="MapMode_Checked"/>
                  <RadioButton x:Name="MapModeErase" Style="{StaticResource SegmentRadio}" GroupName="MapMode" Checked="MapMode_Checked"/>
                </StackPanel>
                <TextBox x:Name="MapZoneNameBox" Width="120" Margin="0,0,8,8"/>
                <ComboBox x:Name="MapZoneColorBox" Width="120" Margin="0,0,8,8"
                          ItemTemplate="{StaticResource ZoneSwatchTemplate}"/>
                <Button x:Name="MapAddZoneButton" Style="{StaticResource GhostButton}" Margin="0,0,12,8" Click="MapAddZone_Click"/>
              </WrapPanel>
              <WrapPanel>
                <Button x:Name="MapZoomOutButton" Style="{StaticResource GhostButton}" Margin="0,0,4,8" Click="MapZoomOut_Click" Width="36"/>
                <Button x:Name="MapZoomInButton" Style="{StaticResource GhostButton}" Margin="0,0,12,8" Click="MapZoomIn_Click" Width="36"/>
                <Button x:Name="MapExportButton" Margin="0,0,8,8" Click="MapExportExcel_Click"/>
                <Button x:Name="MapImportButton" Style="{StaticResource GhostButton}" Margin="0,0,8,8" Click="MapImportExcel_Click"/>
                <Button x:Name="MapRefreshButton" Style="{StaticResource GhostButton}" Margin="0,0,0,8" Click="RefreshAll_Click"/>
              </WrapPanel>
              <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                <Border Width="14" Height="14" Background="#E8E2D6" BorderBrush="#D6CFC2" BorderThickness="1" CornerRadius="3" Margin="0,0,6,0"/>
                <TextBlock x:Name="MapLegendFreeText" VerticalAlignment="Center" Margin="0,0,14,0" FontSize="12" Foreground="{StaticResource InkMutedBrush}"/>
                <Border Width="14" Height="14" Background="#0F766E" CornerRadius="3" Margin="0,0,6,0"/>
                <TextBlock x:Name="MapLegendOccText" VerticalAlignment="Center" Margin="0,0,14,0" FontSize="12" Foreground="{StaticResource InkMutedBrush}"/>
                <ItemsControl x:Name="MapLegendZones" Margin="0,0,10,0">
                  <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                      <StackPanel Orientation="Horizontal"/>
                    </ItemsPanelTemplate>
                  </ItemsControl.ItemsPanel>
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <StackPanel Orientation="Horizontal" Margin="0,0,10,0">
                        <Border Width="12" Height="12" CornerRadius="3" Margin="0,0,4,0"
                                Background="{Binding Brush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1"/>
                        <TextBlock Text="{Binding Name}" VerticalAlignment="Center" FontSize="11"
                                   Foreground="{StaticResource InkMutedBrush}"/>
                      </StackPanel>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock x:Name="MapSelectionText" VerticalAlignment="Center" FontSize="12" Foreground="{StaticResource AccentDeepBrush}"/>
              </StackPanel>
            </StackPanel>
            <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"
                          Background="#F7F4EC">
              <Canvas x:Name="MapCanvas" Background="Transparent"
                      MouseLeftButtonDown="MapCanvas_MouseLeftButtonDown"
                      MouseMove="MapCanvas_MouseMove"
                      MouseLeftButtonUp="MapCanvas_MouseLeftButtonUp"
                      MouseLeave="MapCanvas_MouseLeave"/>
            </ScrollViewer>
          </DockPanel>
          <DockPanel Grid.Column="1">
            <TextBlock x:Name="MapZonesTitle" DockPanel.Dock="Top" FontWeight="SemiBold" Margin="0,0,0,8"
                       Foreground="{StaticResource InkBrush}"/>
            <ListBox x:Name="MapZonesList" DockPanel.Dock="Top" Height="120" Margin="0,0,0,12"
                     SelectionChanged="MapZonesList_SelectionChanged"/>
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
              <StackPanel>
                <TextBlock x:Name="MapChartFillTitle" FontSize="12" Margin="0,0,0,4"
                           Foreground="{StaticResource InkMutedBrush}"/>
                <scottPlot:WpfPlot x:Name="MapPlotFill" Height="120" Margin="0,0,0,10"/>
                <TextBlock x:Name="MapChartFreeOccTitle" FontSize="12" Margin="0,0,0,4"
                           Foreground="{StaticResource InkMutedBrush}"/>
                <scottPlot:WpfPlot x:Name="MapPlotFreeOcc" Height="120" Margin="0,0,0,10"/>
                <TextBlock x:Name="MapChartZonesTitle" FontSize="12" Margin="0,0,0,4"
                           Foreground="{StaticResource InkMutedBrush}"/>
                <scottPlot:WpfPlot x:Name="MapPlotZones" Height="110" Margin="0,0,0,10"/>
                <TextBlock x:Name="MapChartModelsTitle" FontSize="12" Margin="0,0,0,4"
                           Foreground="{StaticResource InkMutedBrush}"/>
                <scottPlot:WpfPlot x:Name="MapPlotModels" Height="130"/>
              </StackPanel>
            </ScrollViewer>
          </DockPanel>
        </Grid>
      </Border>

      <Border x:Name="PanelBrand" Grid.Row="1" Visibility="Collapsed" Background="{StaticResource PanelBrush}"
              CornerRadius="12" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" Padding="24">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
          <StackPanel MaxWidth="560" HorizontalAlignment="Left">
            <TextBlock x:Name="BrandHintText" TextWrapping="Wrap" Foreground="{StaticResource InkMutedBrush}" Margin="0,0,0,14"/>
            <Border BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,0,14"
                    Background="{StaticResource SurfaceMutedBrush}">
              <StackPanel Orientation="Horizontal">
                <Image x:Name="BrandPreviewImage" Width="96" Height="96" Stretch="Uniform" Margin="0,0,16,0"/>
                <StackPanel VerticalAlignment="Center">
                  <Button x:Name="BrandPickLogoButton" Margin="0,0,0,8" Click="BrandPickLogo_Click" HorizontalAlignment="Left"/>
                  <Button x:Name="BrandClearLogoButton" Style="{StaticResource GhostButton}" Click="BrandClearLogo_Click" HorizontalAlignment="Left"/>
                </StackPanel>
              </StackPanel>
            </Border>
            <TextBlock x:Name="LblBrandProduct" Margin="0,0,0,4" Foreground="{StaticResource InkMutedBrush}"/>
            <TextBox x:Name="BrandProductBox" Margin="0,0,0,10"/>
            <TextBlock x:Name="LblBrandDisplay" Margin="0,0,0,4" Foreground="{StaticResource InkMutedBrush}"/>
            <TextBox x:Name="BrandDisplayBox" Margin="0,0,0,10"/>
            <TextBlock x:Name="LblBrandAppTitle" Margin="0,0,0,4" Foreground="{StaticResource InkMutedBrush}"/>
            <TextBox x:Name="BrandAppTitleBox" Margin="0,0,0,10"/>
            <TextBlock x:Name="LblBrandTagline" Margin="0,0,0,4" Foreground="{StaticResource InkMutedBrush}"/>
            <TextBox x:Name="BrandTaglineBox" Margin="0,0,0,10"/>
            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
              <StackPanel Width="140" Margin="0,0,12,0">
                <TextBlock x:Name="LblBrandAccent" Margin="0,0,0,4" Foreground="{StaticResource InkMutedBrush}"/>
                <TextBox x:Name="BrandAccentBox"/>
              </StackPanel>
              <StackPanel Width="140">
                <TextBlock x:Name="LblBrandAccentDeep" Margin="0,0,0,4" Foreground="{StaticResource InkMutedBrush}"/>
                <TextBox x:Name="BrandAccentDeepBox"/>
              </StackPanel>
            </StackPanel>
            <StackPanel Orientation="Horizontal" Margin="0,8,0,8">
              <Button x:Name="BrandSaveButton" Margin="0,0,8,0" Click="BrandSave_Click"/>
              <Button x:Name="BrandResetButton" Style="{StaticResource GhostButton}" Margin="0,0,8,0" Click="BrandReset_Click"/>
              <Button x:Name="BrandOpenFolderButton" Style="{StaticResource GhostButton}" Click="BrandOpenFolder_Click"/>
            </StackPanel>
            <TextBlock x:Name="BrandPathHintText" TextWrapping="Wrap" Foreground="{StaticResource InkMutedBrush}" FontSize="12"/>
          </StackPanel>
        </ScrollViewer>
      </Border>

      <Border x:Name="PanelUsers" Grid.Row="1" Visibility="Collapsed" Background="{StaticResource PanelBrush}"
              CornerRadius="12" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" Padding="20">
        <DockPanel>
          <StackPanel DockPanel.Dock="Top" Margin="0,0,0,12">
            <TextBlock x:Name="UsersHintText" TextWrapping="Wrap" Foreground="{StaticResource InkMutedBrush}" Margin="0,0,0,8"/>
            <Button x:Name="RefreshUsersButton" HorizontalAlignment="Left" Click="RefreshAll_Click"/>
            <TextBlock x:Name="EmptyUsersHint" Style="{StaticResource EmptyStateText}" Visibility="Collapsed"/>
          </StackPanel>
          <DataGrid x:Name="UsersGrid" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False">
            <DataGrid.Columns>
              <DataGridTextColumn Binding="{Binding Username}" Width="140"/>
              <DataGridTextColumn Binding="{Binding DisplayName}" Width="140"/>
              <DataGridTextColumn Binding="{Binding RolesText}" Width="*"/>
              <DataGridTextColumn Binding="{Binding ActiveText}" Width="90"/>
            </DataGrid.Columns>
          </DataGrid>
        </DockPanel>
      </Border>
    </Grid>
  </Grid>
</Window>
